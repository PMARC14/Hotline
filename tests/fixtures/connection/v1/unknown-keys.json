{
  "version": 1,
  "type": "codex",
  "name": "ChatGPT (Codex)",
  "model": "gpt-5.4",
  "effort": "high",
  "extraArgs": ["--search", "-c", "model_verbosity=\"low\""],
  "continueIn": [
    {
      "kind": "app",
      "name": "LM Studio",
      "command": "\"%LOCALAPPDATA%\\Programs\\LM Studio\\LM Studio.exe\"",
      "copyChat": true,
      "futureTargetProp": "kept"
    }
  ],
  "keepCliSessions": true,
  "keepInHotline": false,
  "tools": "inherit",
  "approveAllTools": false,
  "workingDirectory": "C:\\work",
  "prompt": "default",
  "futureConnectionProp": { "flag": true }
}
