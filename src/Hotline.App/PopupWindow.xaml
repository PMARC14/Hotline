<Window
    x:Class="Hotline.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hotline.App"
    Title="Hotline">
    <Grid x:Name="Root" x:FieldModifier="internal" Padding="12,10,12,10" RowSpacing="8"
          AllowDrop="True" KeyDown="Root_KeyDown">
        <Grid.Resources>
          <ResourceDictionary>
            <!-- The text caret is drawn from the text box's background: its colour inverted AND its opacity (WinUI issues
                 #6498, #8207, #9005; no caret-colour API). A transparent or nearly transparent box gives an invisible
                 caret. So the whole message area is one solid surface (the composer and the text box share it): the
                 standard Windows caret then shows light on dark and dark on light. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ComposerSurface" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF2B2B2B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ComposerSurface" Color="#FFFBFBFB" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFBFBFB" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFBFBFB" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFBFBFB" />
                </ResourceDictionary>
                <!-- Contrast themes: the theme's own window colours (otherwise "Default", the dark set, would apply). -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ComposerSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- No minimum height: the message box is as tall as one line of text (Hotline sizes it from the font). -->
            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <!-- Scrollbar: transparent track/background, translucent thumb (acrylic shows through). -->
            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#59808080" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#8C9A9A9A" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A6B0B0B0" />
            <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" /><Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="15" />
            </Style>
          </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />      <!-- messages; empty space reserved above the composer -->
            <RowDefinition Height="Auto" />   <!-- inline notices -->
            <RowDefinition Height="Auto" />   <!-- composer -->
            <RowDefinition Height="Auto" />   <!-- toolbar -->
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MessagesScroll" x:FieldModifier="internal" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MessagesPanel" x:FieldModifier="internal" Spacing="12" Padding="2,4,18,4" VerticalAlignment="Bottom" />
        </ScrollViewer>
        <!-- Shown when you've scrolled up: back to the newest message and following again. -->
        <Button x:Name="JumpToLatestButton" x:FieldModifier="internal" Grid.Row="0" Width="34" Height="34" Padding="0"
                CornerRadius="17" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,6"
                FontFamily="Segoe Fluent Icons" FontSize="14" Content="&#xE74B;" Visibility="Collapsed"
                ToolTipService.ToolTip="{local:Loc Key=Popup_JumpLatest}" />
        <TextBlock x:Name="StatusText" x:FieldModifier="internal" Margin="2,0" VerticalAlignment="Top" Opacity="0.6" IsHitTestVisible="False"
                   Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />

        <StackPanel x:Name="NoticesPanel" x:FieldModifier="internal" Grid.Row="1" Spacing="6" />

        <!-- The bar: the top button row (toolbar.json "top"; collapsed when empty) and the message box. -->
        <StackPanel x:Name="BarStack" x:FieldModifier="internal" Grid.Row="2">
        <Grid x:Name="TopToolbar" x:FieldModifier="internal" ColumnSpacing="2" Margin="0,0,0,8" Visibility="Collapsed" />
        <Border x:Name="Composer" x:FieldModifier="internal" CornerRadius="12" Padding="4" BorderThickness="1"
                Background="{ThemeResource ComposerSurface}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <StackPanel Spacing="4">
                <!-- Quick actions: typing "/" lists ~/.hotline/actions/*.md (Up/Down, Tab or Enter to pick, Esc to close). -->
                <ListView x:Name="SuggestionsList" x:FieldModifier="internal" Visibility="Collapsed" MaxHeight="200"
                          SelectionMode="Single" IsItemClickEnabled="True" IsTabStop="False" Padding="0"
                          AllowFocusOnInteraction="False" />
                <StackPanel x:Name="ChipsPanel" x:FieldModifier="internal" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlusButton" x:FieldModifier="internal" Width="44" Height="44" Padding="0" CornerRadius="10"
                            FontFamily="Segoe Fluent Icons" FontSize="20" Content="&#xE710;" ToolTipService.ToolTip="{local:Loc Key=Popup_AddMenu}"
                            VerticalAlignment="Bottom">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuFlyoutItem x:Name="AttachFilesItem" x:FieldModifier="internal" Text="{local:Loc Key=Popup_AttachFiles}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE723;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CaptureWindowItem" x:FieldModifier="internal" Text="{local:Loc Key=Bar_captureWindow}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CaptureRegionItem" x:FieldModifier="internal" Text="{local:Loc Key=Bar_captureRegion}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF407;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CaptureScreenItem" x:FieldModifier="internal" Text="{local:Loc Key=Bar_captureScreen}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBox x:Name="Input" x:FieldModifier="internal" Grid.Column="1" PlaceholderText="📞 Hotline" Padding="8,4,6,4"
                             MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" VerticalAlignment="Center"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Button x:Name="SendButton" x:FieldModifier="internal" Grid.Column="2" Width="44" Height="44" Padding="0"
                            CornerRadius="10" Style="{StaticResource AccentButtonStyle}" FontFamily="Segoe Fluent Icons"
                            FontSize="16" Content="&#xE724;" ToolTipService.ToolTip="{local:Loc Key=Composer_Send}" VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Bottom toolbar: room for more features (model/effort picker arrives in Plan 3b). -->
        <!-- Bottom toolbar: pin, capture, who answers (provider / model / effort), prompt, new chat, settings. -->
        <Grid x:Name="Toolbar" x:FieldModifier="internal" Grid.Row="3" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="PinButton" x:FieldModifier="internal" Width="36" Height="32" Padding="0" BorderThickness="0"
                          Background="Transparent" FontFamily="Segoe Fluent Icons" FontSize="15" Content="&#xE718;"
                          ToolTipService.ToolTip="{local:Loc Key=Popup_Pin}" />
            <Button x:Name="CaptureWindowButton" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource ToolbarButton}"
                    Content="&#xE7C4;" ToolTipService.ToolTip="{local:Loc Key=Popup_CaptureWindow}" />
            <Button x:Name="CaptureScreenButton" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource ToolbarButton}"
                    Content="&#xE7F4;" ToolTipService.ToolTip="{local:Loc Key=Popup_CaptureScreen}" />
            <!-- Arranged at runtime from ~/.hotline/toolbar.json (see PopupWindow.ApplyToolbar). -->
            <Button x:Name="CaptureRegionButton" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource ToolbarButton}"
                    Content="&#xF407;" ToolTipService.ToolTip="{local:Loc Key=Set_Key_CaptureRegion}" Visibility="Collapsed" />
            <!-- Pickers blend into the bar (no fill/border) until hovered; order: effort, model, provider. -->
            <StackPanel x:Name="PickersPanel" x:FieldModifier="internal" Grid.Column="3" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <!-- Picker text shrinks to fit the (fixed-width) box instead of being cut off. -->
                    <!-- A long name is cut off with "…" at the bar's text size (it used to shrink until unreadable);
                         the full name is in the list and in the tooltip. -->
                    <DataTemplate x:Key="FitText">
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    </DataTemplate>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                        <Setter Property="ItemTemplate" Value="{StaticResource FitText}" />
                        <Setter Property="Height" Value="28" /><Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="6,0,0,0" /><Setter Property="MinWidth" Value="0" />
                        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Opacity" Value="0.85" />
                    </Style>
                </StackPanel.Resources>
                <ComboBox x:Name="EffortBox" x:FieldModifier="internal" ToolTipService.ToolTip="{local:Loc Key=Bar_EffortTip}" />
                <ComboBox x:Name="ModelBox" x:FieldModifier="internal"
                          ToolTipService.ToolTip="{local:Loc Key=Popup_Model}" />
                <ComboBox x:Name="ProviderBox" x:FieldModifier="internal" ToolTipService.ToolTip="{local:Loc Key=Popup_Provider}" />
            </StackPanel>
            <Button x:Name="PromptButton" x:FieldModifier="internal" Grid.Column="5" Style="{StaticResource ToolbarButton}"
                    Content="&#xE8A5;" ToolTipService.ToolTip="{local:Loc Key=Conn_SystemPrompt}">
                <Button.Flyout>
                    <MenuFlyout x:Name="PromptMenu" x:FieldModifier="internal" Placement="TopEdgeAlignedRight" />
                </Button.Flyout>
            </Button>
            <Button x:Name="RecentButton" x:FieldModifier="internal" Grid.Column="6" Style="{StaticResource ToolbarButton}"
                    Content="&#xE81C;" ToolTipService.ToolTip="{local:Loc Key=Popup_Recent}" />
            <Button x:Name="ContinueInButton" x:FieldModifier="internal" Grid.Column="7" Style="{StaticResource ToolbarButton}"
                    Content="&#xE756;" ToolTipService.ToolTip="{local:Loc Key=Recent_ContinueIn}" Visibility="Collapsed" />
            <Button x:Name="NewChatButton" x:FieldModifier="internal" Grid.Column="7" Style="{StaticResource ToolbarButton}"
                    Content="&#xE8BD;" ToolTipService.ToolTip="{local:Loc Key=Popup_NewChat}" />
            <Button x:Name="SettingsButton" x:FieldModifier="internal" Grid.Column="8" Style="{StaticResource ToolbarButton}"
                    Content="&#xE713;" ToolTipService.ToolTip="{local:Loc Key=Bar_settings}" />
        </Grid>
    </Grid>
</Window>
