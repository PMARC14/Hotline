<Window
    x:Class="Hotline.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hotline">
    <Grid x:Name="Root" Padding="16" RowSpacing="12" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Debug-only status line (diagnostics.verboseLogging or Debug build). -->
        <TextBlock x:Name="StatusText" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed"
                   Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBox x:Name="PromptBox" Grid.Row="2" PlaceholderText="📞 Hotline" />
    </Grid>
</Window>
